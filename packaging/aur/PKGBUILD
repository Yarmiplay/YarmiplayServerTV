# Maintainer: Yarmiplay <https://github.com/Yarmiplay>
#
# Repackages the .deb from the GitHub release. The release workflow's aur job sets pkgver and the checksum and
# pushes this file with its .SRCINFO to the AUR.

pkgname=yarmiplayservertv-bin
pkgver=1.2.1
pkgrel=1
pkgdesc="Host a Syncplay server and a Jellyfin server from the system tray"
arch=('x86_64')
url="https://servertv.yarmiplay.com/"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl' 'librsvg' 'hicolor-icon-theme')
optdepends=('gnome-keyring: keep the DuckDNS token in the Secret Service instead of an owner-only file')
provides=('yarmiplayservertv')
conflicts=('yarmiplayservertv')
options=('!strip' '!debug')
source=("YarmiplayServerTV_${pkgver}_amd64.deb::https://github.com/Yarmiplay/YarmiplayServerTV/releases/download/v${pkgver}/YarmiplayServerTV_${pkgver}_amd64.deb")
noextract=("YarmiplayServerTV_${pkgver}_amd64.deb")
sha256sums=('5d2bc165e8f1c11ab3fb65ef7740f7099fb5a5850e0568ac8cebfe0b8f0262b1')

package() {
  bsdtar -xOf "YarmiplayServerTV_${pkgver}_amd64.deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  # The app leaves updates to pacman when this file exists.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/yarmiplayservertv/managed-by" <<< "aur"
}
